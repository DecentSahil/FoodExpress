# ─── Local Development ───────────────────────────────────
# Copy this file to .env and set the value below
VITE_API_BASE_URL=http://localhost:8085

# ─── Docker (docker-compose) ─────────────────────────────
# Override in docker-compose.yml under environment:
#   VITE_API_BASE_URL=http://api-gateway:8080
#
# OR pass as a build-arg in Dockerfile:
#   ARG VITE_API_BASE_URL=http://api-gateway:8080
#   ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
